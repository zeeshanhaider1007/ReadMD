graph LR
    subgraph "Dynamic Memory Lifecycle"
        direction TB
        START[Program starts] --> DECLARE["Declare pointer:
int *p;"]
        DECLARE --> MALLOC["Allocate memory:
p = malloc(5 * sizeof(int));
// Asks OS for 20 bytes"]
        MALLOC --> CHECK{"p == NULL?<br/>(Allocation failed?)"}
        CHECK -->|"Yes"| ERROR["Handle error!
fprintf(stderr,
'Out of memory!');
return 1;"]
        CHECK -->|"No - Success!"| USE["Use the memory:
p[0] = 10;
p[1] = 20;
// Do work with data"]
        USE --> FREE["Free the memory:
free(p);
// Returns memory to OS"]
        FREE --> NULL_PTR["Set to NULL:
p = NULL;
// Prevents dangling pointer"]
        NULL_PTR --> DONE[Program continues]
    end
    
    RULES["Golden Rules:
1. Every malloc() needs a free()
2. Only free() what you malloc()'d
3. After free(), set to NULL
4. Never dereference freed memory"]
    
    style MALLOC fill:#e6f3ff,stroke:#0066cc,stroke-width:2px
    style FREE fill:#e6ffe6,stroke:#00cc00,stroke-width:2px
    style ERROR fill:#ffe6e6,stroke:#cc0000
    style RULES fill:#ffffe6,stroke:#cccc00,stroke-dasharray:5 5
